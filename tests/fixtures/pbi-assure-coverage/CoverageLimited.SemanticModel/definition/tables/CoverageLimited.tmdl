table CoverageLimited
	column UdfUsedSource
		dataType: int64
		sourceColumn: UdfUsedSource

	column UdfUnusedSource
		dataType: int64
		sourceColumn: UdfUnusedSource

	column UnreachedUnusedControl
		dataType: string
		sourceColumn: UnreachedUnusedControl

	measure UsedUdfConsumer = UsedCoverageFunction()

	partition CoverageLimited = m
		mode: import
		source = #table({}, {})
