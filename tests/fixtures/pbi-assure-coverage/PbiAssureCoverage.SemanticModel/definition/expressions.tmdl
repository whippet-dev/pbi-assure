expression ReferencedQuery = #table(type table [Value = number], {{1}})

expression ReferencedParameter = 10 meta [IsParameterQuery=true, Type="Number", IsParameterQueryRequired=true]

expression UnreferencedParameterControl = "control" meta [IsParameterQuery=true, Type="Text", IsParameterQueryRequired=false]

expression ParameterConsumerQuery = #table(type table [Value = number], {{ReferencedParameter}})

expression UnusedQuery = #table(type table [Value = number], {{2}})

expression DynamicQuery = Expression.Evaluate("ReferencedQuery", #shared)

expression LineageTransformQuery =
		let
			Selected = Table.SelectColumns(Fact, {"LineageSelectedColumn"}),
			Removed = Table.RemoveColumns(Fact, {"LineageRemovedColumn"}),
			Renamed = Table.RenameColumns(Fact, {{"LineageRenamedColumn", "RenamedOutput"}}),
			Typed = Table.TransformColumnTypes(Fact, {{"LineageTransformedColumn", type text}}),
			Joined = Table.NestedJoin(Fact, {"LineageMergeKey"}, Dimension, {"DimensionKey"}, "DimensionRows", JoinKind.LeftOuter),
			Expanded = Table.ExpandTableColumn(Joined, "DimensionRows", {"LineageExpandedColumn"}, {"LineageExpandedColumn"})
		in
			Expanded

expression AddColumnLineageQuery =
		let
			Added = Table.AddColumn(Fact, "Added", each [LineageAddLeft] & [LineageAddRight])
		in
			Added

expression GroupLineageQuery =
		let
			Grouped = Table.Group(Fact, {"LineageGroupKey"}, {{"Total", each List.Sum([LineageGroupValue]), type number}})
		in
			Grouped

expression CombineLineageQuery =
		let
			Combined = Table.Combine({Fact, Dimension}, {"LineageCombineFact", "LineageCombineDimension"})
		in
			Combined

expression UnpivotLineageQuery =
		let
			Unpivoted = Table.UnpivotOtherColumns(Fact, {"LineageUnpivotKeepA", "LineageUnpivotKeepB"}, "Attribute", "Value")
		in
			Unpivoted

expression LocalFileQuery = File.Contents("C:\\PbiAssureFixture\\input.csv")

expression NetworkFileQuery = Folder.Files("\\\\fixture-server\\share")

expression RelativeFileQuery = File.Contents("data/input.csv")

expression WebSourceQuery = Web.Contents("https://fixture.invalid/data")

expression NamedServerQuery = Sql.Database("fixture-server", "fixture-db")

expression DynamicSourceQuery = File.Contents(SourcePath)
