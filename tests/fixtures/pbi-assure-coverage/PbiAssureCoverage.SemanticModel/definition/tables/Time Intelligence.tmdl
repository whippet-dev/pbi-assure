table 'Time Intelligence'
	calculationGroup
		precedence: 20

		calculationItem Current = SELECTEDMEASURE()

		calculationItem CoverageYTD = CALCULATE(SELECTEDMEASURE(), Fact[BaseAmount])
			ordinal: 1

		calculationItem 'Coverage measure only' = CALCULATE(SELECTEDMEASURE(), Fact[CalculationItemOnlyColumn])
			ordinal: 2

	column 'Time Calculation'
		dataType: string
		sourceColumn: Name
