/// Principal semantic table for canonical coverage.
table Fact
	column BaseAmount
		dataType: int64
		sourceColumn: BaseAmount

	column IndirectlyUsedColumn
		dataType: int64
		sourceColumn: IndirectlyUsedColumn

	column CalculatedSourceColumn
		dataType: int64
		sourceColumn: CalculatedSourceColumn

	column CalculatedDependencyColumn = Fact[CalculatedSourceColumn]
		dataType: int64

	column UnusedBranchColumn
		dataType: int64
		sourceColumn: UnusedBranchColumn

	column RelationshipKey
		dataType: int64
		sourceColumn: RelationshipKey

	column SortLabel
		dataType: string
		sourceColumn: SortLabel
		sortByColumn: SortKey

	column SortKey
		dataType: int64
		sourceColumn: SortKey

	column HierarchyColumn
		dataType: string
		sourceColumn: HierarchyColumn

	column VisualFilterOnlyColumn
		dataType: string
		sourceColumn: VisualFilterOnlyColumn

	column VisualSortOnlyColumn
		dataType: string
		sourceColumn: VisualSortOnlyColumn

	column ReportFilterColumn
		dataType: string
		sourceColumn: ReportFilterColumn

	column PageFilterColumn
		dataType: string
		sourceColumn: PageFilterColumn

	column LineageSelectedColumn
		dataType: string
		sourceColumn: LineageSelectedColumn

	column LineageRemovedColumn
		dataType: string
		sourceColumn: LineageRemovedColumn

	column LineageRenamedColumn
		dataType: string
		sourceColumn: LineageRenamedColumn

	column LineageTransformedColumn
		dataType: string
		sourceColumn: LineageTransformedColumn

	column LineageMergeKey
		dataType: int64
		sourceColumn: LineageMergeKey

	column FormattingOnlyColumn
		dataType: string
		sourceColumn: FormattingOnlyColumn

	column SelectorOnlyColumn
		dataType: string
		sourceColumn: SelectorOnlyColumn

	column OtherContextColumn
		dataType: string
		sourceColumn: OtherContextColumn

	column MobileFormattingColumn
		dataType: string
		sourceColumn: MobileFormattingColumn

	column InactiveKey
		dataType: int64
		sourceColumn: InactiveKey

	column ManyToManyKey
		dataType: int64
		sourceColumn: ManyToManyKey

	column AutoDateSource
		dataType: dateTime
		sourceColumn: AutoDateSource

	column RefreshWatermark
		dataType: dateTime
		sourceColumn: RefreshWatermark

	column RlsColumn
		dataType: string
		sourceColumn: RlsColumn

	column OlsColumn
		dataType: string
		sourceColumn: OlsColumn

	column AggregationDetail
		dataType: int64
		sourceColumn: AggregationDetail

	column KpiTargetOnly
		dataType: int64
		sourceColumn: KpiTargetOnly

	column KpiStatusOnly
		dataType: int64
		sourceColumn: KpiStatusOnly

	column KpiTrendOnly
		dataType: int64
		sourceColumn: KpiTrendOnly

	column DetailRowsOnly
		dataType: string
		sourceColumn: DetailRowsOnly

	column EstablishedUnusedControl
		dataType: string
		sourceColumn: EstablishedUnusedControl

	column UnresolvedSortColumn
		dataType: string
		sourceColumn: UnresolvedSortColumn
		sortByColumn: MissingSortTarget

	measure DirectlyUsedMeasure = [IndirectlyUsedMeasure] + SUM(Fact[IndirectlyUsedColumn]) + SUM(Fact[CalculatedDependencyColumn])
		formatString: 0

	measure IndirectlyUsedMeasure = SUM(Fact[BaseAmount])
		formatString: 0

	measure ApparentlyUnusedMeasure = 1
		formatString: 0

	measure UnusedBranchMeasure = SUM(Fact[UnusedBranchColumn])
		formatString: 0

	measure KpiBase = SUM(Fact[BaseAmount])
		kpi
			targetExpression = Fact[KpiTargetOnly]
			statusExpression = Fact[KpiStatusOnly]
			trendExpression = Fact[KpiTrendOnly]

	measure DetailRowsBase = SUM(Fact[BaseAmount])
		detailRowsDefinition = SELECTCOLUMNS(Fact, "Detail", Fact[DetailRowsOnly])

	measure InactiveRelationshipMeasure = CALCULATE([DirectlyUsedMeasure], USERELATIONSHIP(Fact[InactiveKey], Dimension[InactiveKey]))

	measure PerspectiveOnlyMeasure = SUM(Fact[BaseAmount])

	measure ReportMeasureActiveSource = SUM(Fact[BaseAmount])

	measure ReportMeasureUnusedSource = SUM(Fact[UnusedBranchColumn])

	refreshPolicy
		policyType: basic
		rollingWindowGranularity: year
		rollingWindowPeriods: 2
		incrementalGranularity: day
		incrementalPeriods: 30
		pollingExpression = List.Max(Fact[RefreshWatermark])
		sourceExpression = let Source = Fact in Source

	hierarchy DiagnosticHierarchy
		level HierarchyLevelOne
			column: HierarchyColumn

	partition Fact = m
		mode: import
		source = #table({}, {})
