table Dimension
	column StructurallyRequiredColumn
		dataType: int64
		sourceColumn: StructurallyRequiredColumn

	column DimensionKey
		dataType: int64
		sourceColumn: DimensionKey

	column LineageExpandedColumn
		dataType: string
		sourceColumn: LineageExpandedColumn

	column InactiveKey
		dataType: int64
		sourceColumn: InactiveKey

	column ManyToManyKey
		dataType: int64
		sourceColumn: ManyToManyKey

	column LineageCombineDimension
		dataType: string
		sourceColumn: LineageCombineDimension

	partition Dimension = m
		mode: import
		source = #table({}, {})
