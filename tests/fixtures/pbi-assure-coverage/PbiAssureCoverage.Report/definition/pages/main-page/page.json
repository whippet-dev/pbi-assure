{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/page/2.1.0/schema.json",
  "name": "main-page",
  "displayName": "Core coverage",
  "displayOption": "FitToPage",
  "height": 720,
  "width": 1280,
  "visualInteractions": [
    {
      "source": "projection-visual",
      "target": "filter-only-visual",
      "type": "DataFilter"
    }
  ],
  "filterConfig": {
    "filters": [
      {
        "name": "PageFilter",
        "field": {
          "Column": {
            "Expression": { "SourceRef": { "Entity": "Fact" } },
            "Property": "PageFilterColumn"
          }
        },
        "type": "Categorical",
        "filter": {
          "Version": 2,
          "From": [{ "Name": "f", "Entity": "Fact", "Type": 0 }],
          "Where": [
            {
              "Condition": {
                "In": {
                  "Expressions": [
                    {
                      "Column": {
                        "Expression": { "SourceRef": { "Source": "f" } },
                        "Property": "PageFilterColumn"
                      }
                    }
                  ],
                  "Values": [[{ "Literal": { "Value": "'Page'" } }]]
                }
              }
            }
          ]
        }
      }
    ]
  }
}
