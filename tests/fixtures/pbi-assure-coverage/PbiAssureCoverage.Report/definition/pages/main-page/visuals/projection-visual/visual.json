                  },
                  "Level": "HierarchyLevelOne"
                }
              }
            },
            {
              "field": {
                "Measure": {
                  "Expression": { "SourceRef": { "Entity": "Fact" } },
                  "Property": "KpiBase"
                }
              }
            },
            {
              "field": {
                "Measure": {
                  "Expression": { "SourceRef": { "Entity": "Fact" } },
                  "Property": "DetailRowsBase"
                }
              }
            },
            {
              "field": {
                "Measure": {
                  "Expression": { "SourceRef": { "Entity": "Fact" } },
                  "Property": "InactiveRelationshipMeasure"
                }
              }
            },
            {
              "field": {
                "Column": {
                  "Expression": { "SourceRef": { "Entity": "Metric Selector" } },
