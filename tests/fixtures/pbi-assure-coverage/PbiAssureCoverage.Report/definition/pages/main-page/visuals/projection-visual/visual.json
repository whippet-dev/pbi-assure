                }
              }
            },
            {
              "field": {
                "Column": {
                  "Expression": { "SourceRef": { "Entity": "Time Intelligence" } },
                  "Property": "Time Calculation"
                }
              }
            },
            {
              "field": {
                "Measure": {
                  "Expression": { "SourceRef": { "Entity": "Fact" } },
                  "Property": "ActiveReportMeasure"
                }
              }
            },
            {
              "field": {
                "Measure": {
                  "Expression": { "SourceRef": { "Entity": "Fact" } },
                  "Property": "ReportRootedUdfMeasure"
                }
              }
            }
          ]
        }
      }
