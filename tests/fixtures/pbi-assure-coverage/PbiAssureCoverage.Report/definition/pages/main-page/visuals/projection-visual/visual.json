      "visualTooltip": [
        {
          "properties": {
            "show": { "expr": { "Literal": { "Value": "true" } } },
            "type": { "expr": { "Literal": { "Value": "'Canvas'" } } },
            "section": { "expr": { "Literal": { "Value": "'tooltip-page'" } } }
          }
        }
      ],
      "selectorControl": [
        {
          "properties": { "lineStyle": { "expr": { "Literal": { "Value": "'solid'" } } } },
          "selector": { "metadata": "Fact.UnusedReportMeasure" }
        }
      ]
    }
  }
}
