createOrReplace

	table Conversion
		lineageTag: 78c21067-b63c-4ec9-b300-3d35a3576029

		calculationGroup

			calculationItem 'As Reported' = SELECTEDMEASURE()

			calculationItem Converted = SELECTEDMEASURE() * MAX(Rates[Rate])

				formatStringDefinition =
						SELECTEDVALUE(
						    Rates[FormatString],
						    SELECTEDMEASUREFORMATSTRING()
						)

			noSelectionExpression = SELECTEDMEASURE() * MAX(Rates[DefaultRate])

				formatStringDefinition =
						SELECTEDVALUE(
						    Rates[DefaultFormat],
						    "0"
						)

