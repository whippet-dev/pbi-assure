@page "/"
@implements IAsyncDisposable
@using System.Text.Json
@using Microsoft.JSInterop
@using PbiAssure.Core.Inventory
@using PbiAssure.Core.Scanning
@using PbiAssure.Reporting
@inject IJSRuntime JS

<PageTitle>Analyse — PBI Assure</PageTitle>

<AppNavigation Current="AppPage.Analyse" HasActiveProject="@(selection is not null || inventory is not null || isBusy)" />

<section class="shell front-door" aria-labelledby="page-title" data-pbiassure-app-ready="true">
    <header class="page-header @(HasProject ? "page-header-compact" : null)">
        <p class="eyebrow">@(HasProject ? "Selected project" : "Local Power BI investigation")</p>
        <h1 id="page-title" tabindex="-1">@(HasProject ? selection!.DisplayName : "Understand your Power BI project")</h1>
        @if (!HasProject)
        {
            <p class="page-lede">Explore your model, report and Power Query. Follow dependencies, review findings and understand the limits of the analysis.</p>
        }
    </header>

    @if (!HasProject)
    {
        <div class="picker">
            <h2>Start with a local project</h2>
            <p id="folder-selection-help">Choose the folder containing your <code>.pbip</code> file, then run the analysis.</p>
            <div class="picker-actions">
                <button @onclick="() => ChooseProjectAsync(false)" disabled="@isBusy" aria-describedby="@PickerDescription">Choose project folder</button>
            </div>
            <p class="privacy"><strong>Local &amp; read-only.</strong> Analysis runs in your browser. Your project is never modified or uploaded. <a href="about#trust" target="_blank" rel="noopener noreferrer">Privacy details</a>.</p>
        </div>
    }

    @if (HasProject && !HasResults)
    {
        <div class="project-bar" role="group" aria-label="Project status and actions" aria-busy="@(IsAnalysing ? "true" : "false")">
            <p class="project-bar-facts">@selection!.Files.Count metadata files · @FormatBytes(selection.TotalBytes)</p>
            <div class="project-bar-actions">
                <button @ref="analysisTrigger" @onclick="RunAssuranceAsync" disabled="@isBusy" aria-describedby="@ProjectMessageId">@RunLabel</button>
                <button class="secondary-button" @onclick="() => ChooseProjectAsync(false)" disabled="@isBusy" aria-describedby="@ProjectMessageId">Change project</button>
            </div>
        </div>
    }

    <div class="analysis-progress @(HasProject ? null : "visually-hidden")">
        <p id="analysis-status" class="analysis-status @(IsAnalysing ? "is-running" : "visually-hidden")" role="status" aria-live="polite" aria-atomic="true">@analysisStatus</p>
    </div>
    @if (!string.IsNullOrWhiteSpace(message))
    {
        <p id="project-message" class="message @(message == BrowserProjectSelectionWorkflow.CancelledMessage ? "message-cancelled" : null)" role="alert">@message</p>
    }

    @if (inventory is not null)
    {
        var confidence = WebConfidenceSummary.FromInventory(inventory);
        <section class="output-actions" aria-labelledby="output-actions-heading" aria-busy="@(IsAnalysing ? "true" : "false")">
            <h2 id="output-actions-heading" tabindex="-1" @ref="completionHeading">Analysis complete</h2>
            <section class="primary-report" aria-labelledby="interactive-report-heading">
                <h3 id="interactive-report-heading" class="visually-hidden">Investigation</h3>
                <p id="interactive-report-help">Your project is ready to explore. Open the investigation to follow usage, inspect evidence and review findings.</p>
                <div class="report-card-actions">
                    <button @onclick="() => OpenInvestigationAsync()" disabled="@isBusy" aria-describedby="interactive-report-help">Open investigation</button>
                </div>
                <p class="report-card-status" role="status">@interactiveReportMessage</p>
            </section>
            @if (confidence.HasQualifiedAbsence || inventory.AnalysisLimitations.Count > 0)
            {
                <div class="confidence-notice"><div><strong>This analysis has limitations</strong><span>Review the scope before relying on absence of usage or findings.</span></div><button class="text-button" @onclick='() => OpenInvestigationAsync("check")' disabled="@isBusy">View analysis scope</button></div>
            }
            <p class="output-note">Opens in a new tab; this project stays here for another analysis. App and viewer URLs do not preserve this analysis.</p>
            <div class="project-bar-actions result-project-actions" role="group" aria-label="Project actions">
                <button class="secondary-button" @ref="analysisTrigger" @onclick="RunAssuranceAsync" disabled="@isBusy" aria-describedby="@ProjectMessageId">@RunLabel</button>
                <button class="secondary-button" @onclick="() => ChooseProjectAsync(false)" disabled="@isBusy" aria-describedby="@ProjectMessageId">Change project</button>
            </div>
            <h3 id="other-outputs-heading">Other outputs</h3>
            <div class="download-report"><button class="secondary-button" @onclick="DownloadHtmlAsync" disabled="@isBusy">Download report</button><p>Keep a standalone HTML report of this analysis. It uses the existing report layout.</p></div>
            <p class="sensitivity">Downloads can contain sensitive project metadata. Review before sharing; outputs are not automatically redacted.</p>
            <div class="other-outputs" role="group" aria-labelledby="other-outputs-heading">
                <section class="report-secondary" aria-labelledby="unused-review-heading">
                    <h4 id="unused-review-heading">Apparently unused review</h4>
                    <p id="unused-review-help">Review model items with no report or semantic-model usage found in this project.</p>
                    <div class="report-card-actions">
                        <button class="secondary-button" @onclick="OpenUnusedReviewAsync" disabled="@isBusy" aria-describedby="unused-review-help">Review apparently unused (@inventory.DeveloperApparentlyUnusedSemanticObjectCount)</button>
                        <button class="secondary-button" @onclick="DownloadUnusedReviewAsync" disabled="@isBusy">Download <span class="visually-hidden">apparently unused </span>review</button>
                    </div>
                    <p class="report-card-status" role="status">@unusedReviewMessage</p>
                </section>
            <section class="export-area" aria-labelledby="export-data-heading">
                <h4 id="export-data-heading">Export data</h4>
                <p id="export-data-help">Export a Data Catalogue or Usage Mapping CSV for further work.</p>
                <button class="secondary-button" @ref="exportToggle" @onclick="ToggleExportPanel" disabled="@isBusy" aria-expanded="@(exportPanelOpen ? "true" : "false")" aria-describedby="export-data-help">Export data</button>
                <details class="summary-help legacy-output">
                    <summary>Advanced: legacy export</summary>
                    <div class="output-action">
                        <p>The existing fixed semantic-usage CSV remains available for technical and compatibility workflows.</p>
                        <button @onclick="DownloadCsvAsync" class="secondary-button" disabled="@isBusy">Download semantic usage CSV</button>
                        <p class="report-card-status" role="status">@legacyCsvMessage</p>
                    </div>
                </details>
            </section>
            </div>
                @if (exportPanelOpen && selection is not null)
                {
                    <ExportCsvPanel @key="exportPanelKey" Inventory="@inventory" ProjectDisplayName="@selection.DisplayName"
                                    OnClose="CloseExportPanelAsync" />
                }
        </section>
    }

    <div class="setup-support @(HasProject ? "setup-support-compact" : null)">
        <details class="guidance-panel">
            <summary>Check or prepare your Power BI project</summary>
            <div class="guidance-content">
                <p>Only have a <code>.pbix</code> file? Save it as a Power BI Project first.</p>
                <p class="guidance-intro">PBIR and TMDL store the report and semantic model as structured project files that PBI Assure can analyse locally in your browser.</p>
                <div class="guidance-steps">
                    <ol>
                        <li>Open the PBIX in Power BI Desktop.</li>
                        <li>In <strong>File &gt; Options and settings &gt; Options &gt; Preview features</strong>, enable <strong>Power BI Project (.pbip) save option</strong> if it is shown.</li>
                        <li>Enable <strong>Store reports using enhanced metadata format (PBIR)</strong> and <strong>Store semantic model using TMDL format</strong>.</li>
                        <li>Save the report as a Power BI Project, then select its project root folder here.</li>
                    </ol>
                    <div class="guidance-example">
                        <div class="folder-example" aria-label="Example supported Power BI project folder structure"><code>MyReport/<br />├── MyReport.pbip<br />├── MyReport.Report/<br />│   └── definition/<br />└── MyReport.SemanticModel/<br />    ├── definition.pbism<br />    └── definition/</code></div>
                        <p class="guidance-caption">Select the <strong>project root</strong> shown above, not the <code>.Report</code> or <code>.SemanticModel</code> folder on its own.</p>
                    </div>
                </div>
                <p class="guidance-warning"><strong>Converting from TMSL cannot be undone.</strong> A local semantic model stored as <code>model.bim</code> (TMSL) is not supported yet. Keep a backup, enable <strong>Store semantic model using TMDL format</strong>, then choose <strong>Upgrade</strong> when saving in Power BI Desktop.</p>
                <p class="guidance-links">Microsoft guidance: <a href="https://learn.microsoft.com/en-us/power-bi/developer/projects/projects-overview" target="_blank" rel="noopener noreferrer">Power BI Projects</a>, <a href="https://learn.microsoft.com/en-us/power-bi/developer/projects/projects-report" target="_blank" rel="noopener noreferrer">PBIR</a>, and <a href="https://learn.microsoft.com/en-us/power-bi/developer/projects/projects-dataset" target="_blank" rel="noopener noreferrer">TMDL semantic models</a>.</p>
            </div>
        </details>
        <details class="picker-help">
            <summary>Having trouble selecting a folder?</summary>
            <div class="picker-help-content">
                <p>Use the alternative folder picker if the normal picker is unavailable or blocked by your browser or organisation.</p>
                <button class="secondary-button" @onclick="() => ChooseProjectAsync(true)" disabled="@isBusy">Use alternative folder picker</button>
            </div>
        </details>
    </div>

</section>

@code {
    private BrowserProjectSelection? selection;
    private JsFileAccess? fileAccessInstance;
    private bool isChoosingProject;
    private ProjectInventory? inventory;
    private string? message;
    private string? interactiveReportMessage;
    private string? unusedReviewMessage;
    private string? legacyCsvMessage;
    private ElementReference exportToggle;
    private bool isBusy;
    private bool exportPanelOpen;
    private int exportPanelKey;

    // Analyse is three states, not one accumulating page: choosing a project, a project ready to
    // analyse, and results. Setup material stops competing with results once it has served its turn.
    private JsFileAccess browserAccess => fileAccessInstance ??= new JsFileAccess(JS);

    private IBrowserProjectFileAccess fileAccess => browserAccess;

    private IBrowserProjectPicker picker => browserAccess;

    private bool HasProject => selection is not null;

    private bool HasResults => inventory is not null;


    // The project now stays on screen while a replacement is being chosen, so "busy with a project
    // selected" no longer means a scan is running. Choosing is excluded explicitly.
    private bool IsAnalysing => isBusy && HasProject && !isChoosingProject;

    private string RunLabel => IsAnalysing ? "Analysing…" : HasResults
        ? selection!.CanRefresh ? "Analyse again" : "Choose folder again to analyse"
        : "Run analysis";

    private string? ProjectMessageId => string.IsNullOrWhiteSpace(message) ? null : "project-message";
    private string PickerDescription => ProjectMessageId is null ? "folder-selection-help" : "folder-selection-help project-message";
    private string? analysisStatus;
    private ElementReference analysisTrigger;
    private ElementReference completionHeading;
    private bool pendingFocusHandoff;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (pendingFocusHandoff && !isBusy)
        {
            pendingFocusHandoff = false;
            await JS.InvokeVoidAsync("pbiAssureAnalysisFocus.finish", message is null ? completionHeading : null);
        }
    }

    public async ValueTask DisposeAsync()
    {
        try { await JS.InvokeVoidAsync("pbiAssureAnalysisFocus.cancel"); }
        catch (JSException) { }
    }

    private async Task<bool> ChooseProjectAsync(bool useFallback)
    {
        isBusy = true;
        isChoosingProject = true;
        message = null;
        ClearActionFeedback();
        try
        {
            // Nothing on screen is cleared up front. A picker that is cancelled or fails leaves the
            // project, its analysis and its export configuration exactly where they were.
            var outcome = await BrowserProjectSelectionWorkflow.ChooseAsync(
                Workspace, picker, useFallback, DescribeSelectionFailure);
            ApplyWorkspace(outcome.Workspace);
            message = outcome.Message;
            if (outcome.Replaced)
            {
                analysisStatus = null;
            }
            return outcome.Replaced;
        }
        finally
        {
            isChoosingProject = false;
            isBusy = false;
        }
    }

    private BrowserProjectWorkspace Workspace =>
        new(selection, inventory, exportPanelKey, exportPanelOpen);

    private void ApplyWorkspace(BrowserProjectWorkspace workspace)
    {
        selection = workspace.Selection;
        inventory = workspace.Inventory;
        exportPanelKey = workspace.ExportConfigurationVersion;
        exportPanelOpen = workspace.ExportPanelOpen;
    }

    private static string DescribeSelectionFailure(Exception exception) => exception switch
    {
        BrowserProjectSelectionException selectionException => selectionException.Message,
        JSException jsException when jsException.Message.Contains("CANCELLED", StringComparison.OrdinalIgnoreCase) =>
            BrowserProjectSelectionWorkflow.CancelledMessage,
        JSException jsException when jsException.Message.Contains("BLOCKED", StringComparison.OrdinalIgnoreCase) =>
            "Folder access was blocked. Open ‘Having trouble selecting a folder?’ and try the alternative folder picker.",
        JSException jsException => PickerErrorMessage(jsException.Message),
        _ => "The project folder could not be validated. Choose the folder again and retry.",
    };

    private async Task RunAssuranceAsync()
    {
        if (isBusy) return;
        var action = BrowserProjectAnalysis.Decide(selection, HasResults);
        if (action == BrowserProjectRerunAction.None)
        {
            return;
        }

        await JS.InvokeVoidAsync("pbiAssureAnalysisFocus.begin", analysisTrigger);
        if (action == BrowserProjectRerunAction.RequiresReselection)
        {
            // Reselect through the existing staged workflow. Failure leaves the previous result intact.
            if (!await ChooseProjectAsync(true))
            {
                await JS.InvokeVoidAsync("pbiAssureAnalysisFocus.cancel");
                return;
            }
            action = BrowserProjectRerunAction.Analyse;
        }

        isBusy = true;
        analysisStatus = "Analysing your project…";
        message = null;
        ClearActionFeedback();
        StateHasChanged();
        try
        {
            // Analysing again re-enumerates the folder first, so files saved since the last run are
            // found and deleted ones stop being read. Nothing is scanned until that has validated.
            var prepared = await BrowserProjectAnalysis.PrepareAsync(
                selection!, fileAccess, action == BrowserProjectRerunAction.RefreshThenAnalyse);
            selection = prepared.Selection;

            inventory = ProjectScanner.Scan(new InMemoryProjectFileSource(selection.DisplayName, prepared.Files));
            exportPanelOpen = false;
            exportPanelKey++;
            analysisStatus = $"Analysis complete for {selection.DisplayName}.";
        }
        catch (BrowserProjectSelectionException exception)
        {
            // Re-reading the folder failed, so there is no new answer. The previous one is left alone.
            message = exception.Message;
        }
        catch (UnsupportedProjectInputException exception)
        {
            message = exception.Message.Replace("assurance output", "report", StringComparison.OrdinalIgnoreCase);
            inventory = null;
        }
        catch (Exception exception) when (exception is InvalidDataException or JsonException or ArgumentException or IOException)
        {
            message = "The selected project could not be analysed. Check that its PBIP, PBIR and semantic-model files are complete and valid.";
            inventory = null;
        }
        catch (JSException exception) when (exception.Message.Contains("NO_HANDLE", StringComparison.OrdinalIgnoreCase) ||
                                            exception.Message.Contains("REFRESH_FAILED", StringComparison.OrdinalIgnoreCase) ||
                                            exception.Message.Contains("BLOCKED", StringComparison.OrdinalIgnoreCase))
        {
            message = "The project folder could not be read again, so the analysis already shown is unchanged. Choose the folder again to analyse its current contents.";
        }
        catch (JSException)
        {
            message = "A selected project file could not be read. Please choose the folder again and retry.";
            inventory = null;
        }
        catch (Exception)
        {
            message = "PBI Assure could not complete the analysis. Choose the project again and retry.";
            inventory = null;
        }
        finally
        {
            isBusy = false;
            if (message is not null) analysisStatus = null;
            pendingFocusHandoff = true;
        }
    }

    /// <summary>Browser file access for the analysis rules, kept to the two JS calls they need.</summary>
    private sealed class JsFileAccess(IJSRuntime js) : IBrowserProjectFileAccess, IBrowserProjectPicker
    {
        public async ValueTask<BrowserProjectSelection> ChooseAsync(bool useFallback) =>
            await js.InvokeAsync<BrowserProjectSelection>(
                "pbiAssureProjectPicker.choose", useFallback, BrowserProjectSelectionLimits.Default);

        public async ValueTask<BrowserProjectSelection> RefreshAsync() =>
            await js.InvokeAsync<BrowserProjectSelection>(
                "pbiAssureProjectPicker.refresh", BrowserProjectSelectionLimits.Default);

        public async ValueTask<byte[]> ReadAsync(string relativePath) =>
            await js.InvokeAsync<byte[]>("pbiAssureProjectPicker.read", relativePath);
    }

    // Feedback sits beside the action that produced it, one line per action group, so the announcement
    // a screen reader hears and the message a sighted reader sees both name the report involved.
    private void ClearActionFeedback()
    {
        interactiveReportMessage = null;
        unusedReviewMessage = null;
        legacyCsvMessage = null;
    }

    private void ToggleExportPanel() => exportPanelOpen = !exportPanelOpen;

    /// <summary>Closing the export workspace returns focus to the control that opened it.</summary>
    private async Task CloseExportPanelAsync()
    {
        exportPanelOpen = false;
        await exportToggle.FocusAsync();
    }

    private async Task DownloadHtmlAsync()
    {
        if (inventory is null || selection is null)
        {
            return;
        }

        interactiveReportMessage = null;
        try
        {
            var html = HtmlReportRenderer.Render(inventory);
            await JS.InvokeVoidAsync("pbiAssureDownload.save", BrowserDownloadFileNames.Html(selection.DisplayName), "text/html;charset=utf-8", html);
            interactiveReportMessage = WebReportViewerStatus.DownloadStarted(WebReportKind.InteractiveReport);
        }
        catch (Exception)
        {
            interactiveReportMessage = WebReportViewerStatus.DownloadFailed(WebReportKind.InteractiveReport);
        }
    }

    private async Task OpenInvestigationAsync(string workspace = "overview")
    {
        if (inventory is null)
        {
            return;
        }

        interactiveReportMessage = "Opening investigation…";
        try
        {
            var status = await JS.InvokeAsync<string>("pbiAssureInvestigation.open",
                JsonSerializer.Serialize(inventory), selection!.DisplayName, workspace);
            interactiveReportMessage = status switch
            {
                "opened" => "Investigation opened in a new tab.",
                "blocked" => "Your browser blocked the new tab. Allow pop-ups for this site, then try again.",
                _ => "The investigation could not be opened. Your analysis is still here; please try again.",
            };
        }
        catch (Exception)
        {
            interactiveReportMessage = "The investigation could not be opened. Your analysis is still here; please try again.";
        }
    }

    /// <summary>
    /// The review travels exactly as the interactive report does: rendered locally, handed to the
    /// same-origin viewer, and reported as opened only once that viewer has acknowledged it.
    /// </summary>
    private async Task OpenUnusedReviewAsync()
    {
        if (inventory is null)
        {
            return;
        }

        unusedReviewMessage = WebReportViewerStatus.Opening(WebReportKind.ApparentlyUnusedReview);
        try
        {
            var html = ApparentlyUnusedReportRenderer.Render(inventory);
            var status = await JS.InvokeAsync<string>("pbiAssureDownload.open", "text/html;charset=utf-8", html);
            unusedReviewMessage = WebReportViewerStatus.Describe(status, WebReportKind.ApparentlyUnusedReview);
        }
        catch (Exception)
        {
            unusedReviewMessage = WebReportViewerStatus.OpenFailed(WebReportKind.ApparentlyUnusedReview);
        }
    }

    /// <summary>The review is saved through the same browser save path as the interactive report.</summary>
    private async Task DownloadUnusedReviewAsync()
    {
        if (inventory is null || selection is null)
        {
            return;
        }

        unusedReviewMessage = null;
        try
        {
            var html = ApparentlyUnusedReportRenderer.Render(inventory);
            await JS.InvokeVoidAsync("pbiAssureDownload.save", BrowserDownloadFileNames.ApparentlyUnusedHtml(selection.DisplayName), "text/html;charset=utf-8", html);
            unusedReviewMessage = WebReportViewerStatus.DownloadStarted(WebReportKind.ApparentlyUnusedReview);
        }
        catch (Exception)
        {
            unusedReviewMessage = WebReportViewerStatus.DownloadFailed(WebReportKind.ApparentlyUnusedReview);
        }
    }

    private async Task DownloadCsvAsync()
    {
        if (inventory is null || selection is null)
        {
            return;
        }

        legacyCsvMessage = null;
        try
        {
            var csv = SemanticUsageCsvRenderer.Render(inventory);
            var csvWithBom = "\uFEFF" + csv;
            await JS.InvokeVoidAsync("pbiAssureDownload.save", BrowserDownloadFileNames.SemanticUsageCsv(selection.DisplayName), "text/csv;charset=utf-8", csvWithBom);
            legacyCsvMessage = "Download started: semantic usage CSV.";
        }
        catch (Exception)
        {
            legacyCsvMessage = "The semantic usage CSV could not be generated or downloaded.";
        }
    }

    private static string FormatBytes(long value) => value switch
    {
        < 1024 => $"{value:N0} bytes",
        < 1024 * 1024 => $"{value / 1024d:N1} KB",
        _ => $"{value / (1024d * 1024d):N1} MB",
    };

    private static string PickerErrorMessage(string error) => error switch
    {
        var value when value.Contains("NO_PROJECT", StringComparison.OrdinalIgnoreCase) =>
            "No Power BI project was found. Choose the folder that directly contains the .pbip file.",
        var value when value.Contains("MULTIPLE_PROJECTS", StringComparison.OrdinalIgnoreCase) =>
            "More than one Power BI project was found. Choose one project folder at a time.",
        var value when value.Contains("DUPLICATE_PATH", StringComparison.OrdinalIgnoreCase) =>
            "The project contains duplicate file paths that differ only by letter case.",
        var value when value.Contains("VISITED_LIMIT", StringComparison.OrdinalIgnoreCase) =>
            "That folder contains too many items. Choose the Power BI project folder itself.",
        var value when value.Contains("FILE_COUNT_LIMIT", StringComparison.OrdinalIgnoreCase) =>
            "That project contains too many metadata files for this browser version.",
        var value when value.Contains("FILE_SIZE_LIMIT", StringComparison.OrdinalIgnoreCase) =>
            "A project metadata file is too large for this browser version.",
        var value when value.Contains("TOTAL_SIZE_LIMIT", StringComparison.OrdinalIgnoreCase) =>
            "That project contains too much metadata for this browser version.",
        var value when value.Contains("DEPTH_LIMIT", StringComparison.OrdinalIgnoreCase) =>
            "That project contains a folder structure that is too deeply nested.",
        _ => "The project folder could not be opened. Open ‘Having trouble selecting a folder?’ and try the alternative folder picker.",
    };
}
