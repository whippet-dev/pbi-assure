@page "/"
@using System.Diagnostics
@using System.Text.Json
@using Microsoft.JSInterop
@using PbiAssure.Core.Inventory
@using PbiAssure.Core.Scanning
@using PbiAssure.Reporting
@inject IJSRuntime JS

<PageTitle>Analyse — PBI Assure</PageTitle>

<AppNavigation Current="AppPage.Analyse" HasActiveProject="@(selection is not null || inventory is not null || isBusy)" />

<section class="shell" aria-labelledby="page-title" data-pbiassure-app-ready="true">
    <header class="page-header @(HasProject ? "page-header-compact" : null)">
        <p class="eyebrow">@(HasProject ? "Selected project" : "Model intelligence")</p>
        <h1 id="page-title" tabindex="-1">@(HasProject ? selection!.DisplayName : "Understand your Power BI project")</h1>
        @if (!HasProject)
        {
            <p class="page-lede">PBI Assure performs read-only analysis of Power BI project metadata: how your semantic model — tables, fields and calculations — fits together with Power Query and the report.</p>
            <ul class="orientation-outcomes">
                <li>Find model objects with no detected usage</li>
                <li>Trace where fields and measures are used</li>
                <li>Understand model and Power Query dependencies</li>
                <li>Export catalogue and usage metadata</li>
            </ul>
            <p class="coverage-pointer">Want to know exactly what gets analysed? <a href="coverage">View coverage</a></p>
        }
    </header>

    @if (!HasProject || !string.IsNullOrWhiteSpace(message))
    {
        <p class="supported-input">For supported local semantic-model analysis, use a PBIP project with PBIR and TMDL (<code>.SemanticModel/definition/</code>). Local <code>model.bim</code> (TMSL) models are not supported by this version yet.</p>
    }

    @if (HasProject)
    {
        <div class="project-bar" role="group" aria-label="Project status and actions" aria-live="polite">
            <div class="project-bar-identity">
                <p class="project-bar-facts">@selection!.Files.Count files · @FormatBytes(selection.TotalBytes)</p>
            </div>
            <div class="project-bar-actions">
                <button class="@(HasResults ? "secondary-button" : null)" @onclick="RunAssuranceAsync" disabled="@isBusy">@RunLabel</button>
                <button class="secondary-button" @onclick="() => ChooseProjectAsync(false)" disabled="@isBusy">Change project</button>
            </div>
        </div>
    }
    else
    {
        <div class="picker">
            <div class="picker-actions">
                <button @onclick="() => ChooseProjectAsync(false)" disabled="@isBusy">Choose Power BI project</button>
            </div>
            <p class="privacy"><strong>Kept on this device:</strong> your Power BI project is processed locally in your browser. Project files and analysis results are not uploaded to PBI Assure. <a href="https://github.com/whippet-dev/pbi-assure/blob/master/PRIVACY.md" target="_blank" rel="noopener noreferrer">How privacy works</a>.</p>
        </div>
    }

    <div class="setup-support @(HasProject ? "setup-support-compact" : null)">
        <details class="guidance-panel">
            <summary>Check or prepare your Power BI project</summary>
            <div class="guidance-content">
                <p class="guidance-intro">PBIR and TMDL store the report and semantic model as structured project files that PBI Assure can analyse locally in your browser.</p>
                <div class="guidance-steps">
                    <ol>
                        <li>Open the PBIX in Power BI Desktop.</li>
                        <li>In <strong>File &gt; Options and settings &gt; Options &gt; Preview features</strong>, enable <strong>Power BI Project (.pbip) save option</strong> if it is shown.</li>
                        <li>Enable <strong>Store reports using enhanced metadata format (PBIR)</strong> and <strong>Store semantic model using TMDL format</strong>.</li>
                        <li>Save the report as a Power BI Project, then select its project root folder here.</li>
                    </ol>
                    <div class="guidance-example">
                        <div class="folder-example" aria-label="Example supported Power BI project folder structure"><code>MyReport/<br />├── MyReport.pbip<br />├── MyReport.Report/<br />│   └── definition/<br />└── MyReport.SemanticModel/<br />    ├── definition.pbism<br />    └── definition/</code></div>
                        <p class="guidance-caption">Select the <strong>project root</strong> shown above, not the <code>.Report</code> or <code>.SemanticModel</code> folder on its own.</p>
                    </div>
                </div>
                <p class="guidance-warning"><strong>Converting from TMSL cannot be undone.</strong> A local semantic model stored as <code>model.bim</code> (TMSL) is not supported yet. Keep a backup, enable <strong>Store semantic model using TMDL format</strong>, then choose <strong>Upgrade</strong> when saving in Power BI Desktop.</p>
                <p class="guidance-links">Microsoft guidance: <a href="https://learn.microsoft.com/en-us/power-bi/developer/projects/projects-overview" target="_blank" rel="noopener noreferrer">Power BI Projects</a>, <a href="https://learn.microsoft.com/en-us/power-bi/developer/projects/projects-report" target="_blank" rel="noopener noreferrer">PBIR</a>, and <a href="https://learn.microsoft.com/en-us/power-bi/developer/projects/projects-dataset" target="_blank" rel="noopener noreferrer">TMDL semantic models</a>.</p>
            </div>
        </details>
        <details class="picker-help">
            <summary>Having trouble selecting a folder?</summary>
            <div class="picker-help-content">
                <p>Use the alternative folder picker if the normal picker is unavailable or blocked by your browser or organisation.</p>
                <button class="secondary-button" @onclick="() => ChooseProjectAsync(true)" disabled="@isBusy">Use alternative folder picker</button>
            </div>
        </details>
    </div>

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <p class="message" role="alert">@message</p>
    }

    @if (inventory is not null)
    {
        var assurance = WebAssuranceSummary.FromFindings(inventory.Findings);
        <section class="output-actions" aria-labelledby="output-actions-heading">
            <h2 id="output-actions-heading">Next steps</h2>
            <p class="output-lede">Analysis complete. Start with the interactive report, export reusable metadata, or review the summary below.</p>
            <div class="output-primary">
                <button @onclick="OpenHtmlAsync" disabled="@isBusy" aria-describedby="open-report-help">Open interactive report</button>
                <p id="open-report-help">Start here to explore model usage, dependencies, report structure and findings.</p>
            </div>
            <div class="output-secondary">
                <div class="output-action">
                    <button class="secondary-button" @onclick="() => exportPanelOpen = !exportPanelOpen" disabled="@isBusy" aria-expanded="@exportPanelOpen">Export data</button>
                    <p>Data Catalogue or Usage Mapping CSV.</p>
                </div>
                <div class="output-action">
                    <button @onclick="DownloadHtmlAsync" class="secondary-button" disabled="@isBusy">Download HTML report</button>
                    <p>Save a copy to review elsewhere.</p>
                </div>
            </div>
            @if (exportPanelOpen && selection is not null)
            {
                <ExportCsvPanel @key="exportPanelKey" Inventory="@inventory" ProjectDisplayName="@selection.DisplayName"
                                OnClose="() => exportPanelOpen = false" />
            }
            <details class="summary-help legacy-output">
                <summary>Advanced: legacy export</summary>
                <div class="output-action">
                    <p>The existing fixed semantic-usage CSV remains available for technical and compatibility workflows.</p>
                    <button @onclick="DownloadCsvAsync" class="secondary-button" disabled="@isBusy">Download semantic usage CSV</button>
                </div>
            </details>
            <p class="sensitivity"><strong>Before sharing generated outputs:</strong> HTML and CSV files may contain sensitive project metadata, including paths, expressions, source details and model/report metadata. Review before sharing; outputs are not automatically redacted.</p>
        </section>

        <section class="results" aria-labelledby="results-title">
            <h2 id="results-title">Analysis summary</h2>
            <details class="summary-help summary-guide">
                <summary>How to read these results</summary>
                <div class="summary-guide-groups">
                    <section>
                        <h4>Semantic usage</h4>
                        <dl>
                            <div class="metric-used"><dt>Directly used</dt><dd>Used somewhere in the report, such as a visual, filter, tooltip or drillthrough setting.</dd></div>
                            <div class="metric-indirect"><dt>Indirectly used</dt><dd>Not used directly in the report, but needed by something that is.</dd></div>
                            <div class="metric-structural"><dt>Structurally required</dt><dd>Needed for the model to work, for example in a relationship, hierarchy or sort-by setting.</dd></div>
                            <div class="metric-branch"><dt>Only used by unused items</dt><dd>Only used by other model items that themselves have no detected report usage.</dd></div>
                            <div class="metric-unused"><dt>Apparently unused</dt><dd>PBI Assure could not find anything in this project that uses it. Check before removing it because external reports and dynamic behaviour may not be visible here.</dd></div>
                        </dl>
                    </section>
                    <section>
                        <h4>Project</h4>
                        <dl>
                            <div><dt>Reports</dt><dd>Reports found in the analysed project.</dd></div>
                            <div><dt>Pages</dt><dd>Report pages found across those reports.</dd></div>
                            <div><dt>Visuals</dt><dd>Visuals found on those pages.</dd></div>
                            <div><dt>Your model objects</dt><dd>Columns, measures and other model objects that you authored.</dd></div>
                            <div><dt>System-generated model objects</dt><dd>Objects Power BI generated itself, counted separately from your own.</dd></div>
                        </dl>
                    </section>
                    <section>
                        <h4>Power Query</h4>
                        <dl>
                            <div><dt>Power Query queries</dt><dd>Power Query queries found in this project.</dd></div>
                            <div><dt>Data source types</dt><dd>Different types of recognised data sources used by those queries. This is not the number of individual connections.</dd></div>
                            <div><dt>Data source references</dt><dd>Recognised data source functions found in Power Query, counted once per query and function. This is not a count of physical connections either.</dd></div>
                        </dl>
                    </section>
                    <section>
                        <h4>Assurance</h4>
                        <dl>
                            <div class="metric-error"><dt>Errors</dt><dd>Higher-confidence issues that would normally merit attention.</dd></div>
                            <div class="metric-warning"><dt>Warnings</dt><dd>Potential problems, good-practice concerns or lower-confidence issues worth reviewing.</dd></div>
                            <div class="metric-review"><dt>Review required</dt><dd>Situations that need human judgement or contextual review; they are not necessarily defects.</dd></div>
                            <div><dt>Total findings</dt><dd>All non-accessibility issues and review items found by the automated checks.</dd></div>
                        </dl>
                        <p class="summary-guide-note">Accessibility observations are not part of these counts. They stay in the HTML report’s Accessibility review.</p>
                    </section>
                </div>
            </details>
            <div class="summary-group">
                <h3>Semantic usage</h3>
                <p>How model objects are used by the report and by one another.</p>
            </div>
            <div class="metrics">
                <Metric Label="Directly used" Value="@UsageCount(SemanticUsageStates.DirectlyUsed)" State="used" />
                <Metric Label="Indirectly used" Value="@UsageCount(SemanticUsageStates.IndirectlyUsed)" State="indirect" />
                <Metric Label="Structurally required" Value="@UsageCount(SemanticUsageStates.StructurallyRequired)" State="structural" />
                <Metric Label="Only used by unused items" Value="@UsageCount(SemanticUsageStates.UsedOnlyByUnusedBranch)" State="branch" />
                <Metric Label="Apparently unused" Value="@inventory.DeveloperApparentlyUnusedSemanticObjectCount" State="unused" />
            </div>
            <details class="summary-help">
                <summary>What does “Apparently unused” mean?</summary>
                <p>PBI Assure could not find anything in this project that uses it. This does not prove it is safe to delete; external reports and dynamic behaviour may not be visible here.</p>
            </details>
            <div class="summary-group">
                <h3>Project</h3>
                <p>Counts of the report, pages, visuals and model objects found.</p>
            </div>
            <div class="metrics project-metrics">
                <Metric Label="Reports" Value="@inventory.ReportCount" />
                <Metric Label="Pages" Value="@inventory.PageCount" />
                <Metric Label="Visuals" Value="@inventory.VisualCount" />
                <Metric Label="Your model objects" Value="@inventory.DeveloperSemanticObjectCount" />
                <Metric Label="System-generated model objects" Value="@inventory.SystemGeneratedSemanticObjectCount" />
            </div>
            <div class="summary-group">
                <h3>Power Query</h3>
                <p>Queries and recognised data-source references found in the project.</p>
            </div>
            <div class="metrics power-query-metrics">
                <Metric Label="Power Query queries" Value="@inventory.PowerQueryCount" />
                <Metric Label="Data source types" Value="@inventory.DistinctConnectorFamilyCount" />
                <Metric Label="Data source references" Value="@inventory.DataSourceCount" />
            </div>
            <div class="summary-group">
                <h3>Assurance</h3>
                <p>Non-accessibility issues and review items found by the automated checks.</p>
            </div>
            <div class="metrics">
                <Metric Label="Errors" Value="@assurance.Errors" State="error" />
                <Metric Label="Warnings" Value="@assurance.Warnings" State="warning" />
                <Metric Label="Review required" Value="@assurance.ReviewRequired" State="review" />
                <Metric Label="Total findings" Value="@assurance.TotalFindings" />
            </div>
            <p class="metrics-note">Accessibility observations are excluded from these Assurance counts and remain available separately in the HTML report’s Accessibility review.</p>
        </section>

        @if (!string.IsNullOrWhiteSpace(outputMessage))
        {
            <p class="message" role="status">@outputMessage</p>
        }
        <p class="diagnostic">@TimingSummary</p>
    }
</section>

@code {
    private BrowserProjectSelection? selection;
    private ProjectInventory? inventory;
    private string? message;
    private string? outputMessage;
    private bool isBusy;
    private TimeSpan selectionElapsed;
    private TimeSpan fileReadElapsed;
    private TimeSpan scanElapsed;
    private TimeSpan? htmlRenderElapsed;
    private TimeSpan? csvRenderElapsed;
    private long htmlLength;
    private long csvLength;
    private bool exportPanelOpen;
    private int exportPanelKey;

    // Analyse is three states, not one accumulating page: choosing a project, a project ready to
    // analyse, and results. Setup material stops competing with results once it has served its turn.
    private bool HasProject => selection is not null;

    private bool HasResults => inventory is not null;

    // A project is only ever on screen while it is being analysed, never while one is being chosen:
    // ChooseProjectAsync clears the selection before it awaits, so the picker is showing instead.
    private bool IsAnalysing => isBusy && HasProject;

    private string RunLabel => IsAnalysing ? "Analysing…" : HasResults ? "Analyse again" : "Run analysis";

    private int UsageCount(string state) => inventory?.DeveloperSemanticObjectCountForState(state) ?? 0;

    private string TimingSummary
    {
        get
        {
            var timings = new List<string>
            {
                $"Selection: {selectionElapsed.TotalMilliseconds:N0} ms",
                $"File read: {fileReadElapsed.TotalMilliseconds:N0} ms",
                $"Scan: {scanElapsed.TotalMilliseconds:N0} ms",
            };
            if (htmlRenderElapsed is { } htmlElapsed)
            {
                timings.Add($"HTML: {htmlElapsed.TotalMilliseconds:N0} ms ({FormatBytes(htmlLength)})");
            }

            if (csvRenderElapsed is { } csvElapsed)
            {
                timings.Add($"CSV: {csvElapsed.TotalMilliseconds:N0} ms ({FormatBytes(csvLength)})");
            }

            return string.Join(" · ", timings);
        }
    }

    private async Task ChooseProjectAsync(bool useFallback)
    {
        isBusy = true;
        message = null;
        outputMessage = null;
        inventory = null;
        selection = null;
        exportPanelOpen = false;
        exportPanelKey++;
        try
        {
            var stopwatch = Stopwatch.StartNew();
            var picked = await JS.InvokeAsync<BrowserProjectSelection>(
                "pbiAssureProjectPicker.choose",
                useFallback,
                BrowserProjectSelectionLimits.Default);
            selection = BrowserProjectSelectionValidator.Validate(picked);
            selectionElapsed = stopwatch.Elapsed;
        }
        catch (BrowserProjectSelectionException exception)
        {
            message = exception.Message;
            selection = null;
        }
        catch (JSException exception) when (exception.Message.Contains("CANCELLED", StringComparison.OrdinalIgnoreCase))
        {
            message = "Project selection was cancelled.";
        }
        catch (JSException exception) when (exception.Message.Contains("BLOCKED", StringComparison.OrdinalIgnoreCase))
        {
            message = "Folder access was blocked. Open ‘Having trouble selecting a folder?’ and try the alternative folder picker.";
        }
        catch (JSException exception)
        {
            message = PickerErrorMessage(exception.Message);
            selection = null;
        }
        catch (Exception)
        {
            message = "The project folder could not be validated. Choose the folder again and retry.";
            selection = null;
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task RunAssuranceAsync()
    {
        if (selection is null)
        {
            return;
        }

        isBusy = true;
        message = null;
        outputMessage = null;
        try
        {
            var readStopwatch = Stopwatch.StartNew();
            var files = new List<ProjectFileContent>(selection.Files.Count);
            foreach (var file in selection.Files)
            {
                var contents = await JS.InvokeAsync<byte[]>("pbiAssureProjectPicker.read", file.RelativePath);
                files.Add(new ProjectFileContent(file.RelativePath, contents));
            }

            fileReadElapsed = readStopwatch.Elapsed;
            var scanStopwatch = Stopwatch.StartNew();
            inventory = ProjectScanner.Scan(new InMemoryProjectFileSource(selection.DisplayName, files));
            exportPanelOpen = false;
            exportPanelKey++;
            scanElapsed = scanStopwatch.Elapsed;
            htmlRenderElapsed = null;
            csvRenderElapsed = null;
            htmlLength = 0;
            csvLength = 0;
        }
        catch (UnsupportedProjectInputException exception)
        {
            message = exception.Message;
            inventory = null;
        }
        catch (Exception exception) when (exception is InvalidDataException or JsonException or ArgumentException or IOException)
        {
            message = "The selected project could not be analysed. Check that its PBIP, PBIR and semantic-model files are complete and valid.";
            inventory = null;
        }
        catch (JSException)
        {
            message = "A selected project file could not be read. Please choose the folder again and retry.";
            inventory = null;
        }
        catch (Exception)
        {
            message = "PBI Assure could not complete the analysis. Choose the project again and retry.";
            inventory = null;
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task DownloadHtmlAsync()
    {
        if (inventory is null || selection is null)
        {
            return;
        }

        outputMessage = null;
        try
        {
            var stopwatch = Stopwatch.StartNew();
            var html = HtmlReportRenderer.Render(inventory);
            htmlRenderElapsed = stopwatch.Elapsed;
            htmlLength = System.Text.Encoding.UTF8.GetByteCount(html);
            await JS.InvokeVoidAsync("pbiAssureDownload.save", BrowserDownloadFileNames.Html(selection.DisplayName), "text/html;charset=utf-8", html);
            outputMessage = "HTML report generated and downloaded locally.";
        }
        catch (Exception)
        {
            outputMessage = "Analysis completed, but the HTML report could not be generated or downloaded.";
        }
    }

    private async Task OpenHtmlAsync()
    {
        if (inventory is null)
        {
            return;
        }

        outputMessage = null;
        try
        {
            var stopwatch = Stopwatch.StartNew();
            var html = HtmlReportRenderer.Render(inventory);
            htmlRenderElapsed = stopwatch.Elapsed;
            htmlLength = System.Text.Encoding.UTF8.GetByteCount(html);
            var opened = await JS.InvokeAsync<bool>("pbiAssureDownload.open", "text/html;charset=utf-8", html);
            outputMessage = opened
                ? "HTML report opened in a new tab."
                : "The browser blocked the new tab. Allow pop-ups for this site or download the HTML report instead.";
        }
        catch (Exception)
        {
            outputMessage = "Analysis completed, but the HTML report could not be generated or opened.";
        }
    }

    private async Task DownloadCsvAsync()
    {
        if (inventory is null || selection is null)
        {
            return;
        }

        outputMessage = null;
        try
        {
            var stopwatch = Stopwatch.StartNew();
            var csv = SemanticUsageCsvRenderer.Render(inventory);
            csvRenderElapsed = stopwatch.Elapsed;
            var csvWithBom = "\uFEFF" + csv;
            csvLength = System.Text.Encoding.UTF8.GetByteCount(csvWithBom);
            await JS.InvokeVoidAsync("pbiAssureDownload.save", BrowserDownloadFileNames.SemanticUsageCsv(selection.DisplayName), "text/csv;charset=utf-8", csvWithBom);
            outputMessage = "Semantic usage CSV generated and downloaded locally.";
        }
        catch (Exception)
        {
            outputMessage = "Analysis completed, but the CSV could not be generated or downloaded.";
        }
    }

    private static string FormatBytes(long value) => value switch
    {
        < 1024 => $"{value:N0} bytes",
        < 1024 * 1024 => $"{value / 1024d:N1} KB",
        _ => $"{value / (1024d * 1024d):N1} MB",
    };

    private static string PickerErrorMessage(string error) => error switch
    {
        var value when value.Contains("NO_PROJECT", StringComparison.OrdinalIgnoreCase) =>
            "No Power BI project was found. Choose the folder that directly contains the .pbip file.",
        var value when value.Contains("MULTIPLE_PROJECTS", StringComparison.OrdinalIgnoreCase) =>
            "More than one Power BI project was found. Choose one project folder at a time.",
        var value when value.Contains("DUPLICATE_PATH", StringComparison.OrdinalIgnoreCase) =>
            "The project contains duplicate file paths that differ only by letter case.",
        var value when value.Contains("VISITED_LIMIT", StringComparison.OrdinalIgnoreCase) =>
            "That folder contains too many items. Choose the Power BI project folder itself.",
        var value when value.Contains("FILE_COUNT_LIMIT", StringComparison.OrdinalIgnoreCase) =>
            "That project contains too many metadata files for this browser version.",
        var value when value.Contains("FILE_SIZE_LIMIT", StringComparison.OrdinalIgnoreCase) =>
            "A project metadata file is too large for this browser version.",
        var value when value.Contains("TOTAL_SIZE_LIMIT", StringComparison.OrdinalIgnoreCase) =>
            "That project contains too much metadata for this browser version.",
        var value when value.Contains("DEPTH_LIMIT", StringComparison.OrdinalIgnoreCase) =>
            "That project contains a folder structure that is too deeply nested.",
        _ => "The project folder could not be opened. Open ‘Having trouble selecting a folder?’ and try the alternative folder picker.",
    };
}
