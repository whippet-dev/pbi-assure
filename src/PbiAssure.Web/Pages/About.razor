@page "/about"
@implements IDisposable
@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.AspNetCore.Components.Web
@inject NavigationManager Navigation

<PageTitle>What PBI Assure does — PBI Assure</PageTitle>

<AppNavigation IsInformationPage="true" />

<article class="shell information-page" aria-labelledby="about-title">
    <header>
        <p class="eyebrow">Model intelligence</p>
        <h1 id="about-title" tabindex="-1">What PBI Assure does</h1>
        <p>A practical guide to understanding your project and using the evidence it contains.</p>
    </header>

    <div class="about-tabs" role="tablist" aria-label="About PBI Assure">
        @for (var index = 0; index < Tabs.Length; index++)
        {
            var position = index;
            var tab = Tabs[position];
            var selected = tab.Fragment == active.Fragment;
            <button type="button" role="tab" class="about-tab"
                    id="@TabId(tab)" aria-controls="@PanelId(tab)"
                    aria-selected="@(selected ? "true" : "false")" tabindex="@(selected ? 0 : -1)"
                    @ref="tabButtons[position]"
                    @onclick="() => Select(tab, keepHistoryEntry: true)"
                    @onkeydown="args => MoveAsync(args, position)">@tab.Label</button>
        }
    </div>

    <section class="about-panel" role="tabpanel" tabindex="0" id="@PanelId(Overview)"
             aria-labelledby="@TabId(Overview)" hidden="@(active.Fragment != Overview.Fragment)">
        <h2>@Overview.Label</h2>
        <section aria-labelledby="about-what-is">
            <h3 id="about-what-is">What is PBI Assure?</h3>
            <p>PBI Assure is a read-only analyser of structured Power BI project metadata. It helps you explore an unfamiliar project and understand its semantic model — the tables, fields and calculations behind the report — with evidence of where objects are used and what depends on them.</p>
        </section>
        <section aria-labelledby="about-understand">
            <h3 id="about-understand">What can it help me understand?</h3>
            <ul>
                <li>Find model objects with no detected usage. <strong>Apparently unused</strong> means no use was found in the scanned project, not permission to delete.</li>
                <li>Explore <strong>semantic usage</strong>: objects used directly by the report, needed indirectly by another object, or required by model structure.</li>
                <li>Trace where fields and measures are used across report pages and visuals, and follow their semantic dependencies.</li>
                <li>Understand Power Query dependencies, review model relationships, and inspect report, page and visual metadata.</li>
            </ul>
            <p>Selected findings, Theme Review and Accessibility review provide supporting checks alongside this model intelligence.</p>
        </section>
    </section>

    <section class="about-panel" role="tabpanel" tabindex="0" id="@PanelId(Analysis)"
             aria-labelledby="@TabId(Analysis)" hidden="@(active.Fragment != Analysis.Fragment)">
        <h2>@Analysis.Label</h2>
        <section aria-labelledby="about-analyses">
            <h3 id="about-analyses">What does it analyse?</h3>
            <dl class="information-definitions">
                <div><dt>Semantic model</dt><dd>Objects and retained metadata, their usage classifications, and the dependency evidence behind them.</dd></div>
                <div><dt>Power Query</dt><dd>Queries that prepare data, detected query dependencies and recognised data-source references.</dd></div>
                <div><dt>Model relationships</dt><dd>Connections between tables and their persisted settings.</dd></div>
                <div><dt>Report pages and visuals</dt><dd>Report structure, visual metadata and detected references to the model.</dd></div>
                <div><dt>Selected quality reviews</dt><dd>Findings highlight supported issues and items for human review. Theme Review examines supported theme properties; Accessibility review highlights supported concerns such as alternative text and tab order. Neither specialist review is comprehensive.</dd></div>
            </dl>
        </section>
    </section>

    <section class="about-panel" role="tabpanel" tabindex="0" id="@PanelId(Outputs)"
             aria-labelledby="@TabId(Outputs)" hidden="@(active.Fragment != Outputs.Fragment)">
        <h2>@Outputs.Label</h2>
        <section aria-labelledby="about-outputs">
            <h3 id="about-outputs">What do I get after a scan?</h3>
            <div class="information-outputs">
                <div class="information-output information-output-primary">
                    <p class="information-output-kicker">Start here</p>
                    <h4>Interactive HTML report</h4>
                    <p>Explore semantic usage, dependency evidence, Power Query, relationships and the report/page/visual inventory, with findings and specialist reviews alongside them. Open it in the browser or download it for later review.</p>
                </div>
                <div class="information-output">
                    <p class="information-output-kicker">One row per model object</p>
                    <h4>Data Catalogue CSV</h4>
                    <p>Reusable metadata for documentation, catalogues and governance: one row per eligible developer-authored column or measure, including objects with zero detected usage. Choose semantic usage, confidence, user-facing evidence, usage counts and contexts, and optional metadata such as Description.</p>
                </div>
                <div class="information-output">
                    <p class="information-output-kicker">One row per report usage</p>
                    <h4>Usage Mapping CSV</h4>
                    <p>Answer “where and how is this field used?” with one row per logical direct report usage: a report location and context/role, rather than a separate row for every piece of supporting evidence. Includes report, page and visual provenance where applicable, user-facing evidence and optional technical provenance.</p>
                </div>
            </div>
            <p class="information-definition"><strong>UserFacing</strong> describes whether qualifying direct report-presentation or intentional-interaction evidence was found. It is separate from semantic usage: directly used does not automatically mean Yes. No means no qualifying evidence was found, not proof that users can never encounter the object; Unclear means the retained direct context cannot be classified confidently.</p>
            <p class="secondary-output">The existing fixed <strong>semantic usage CSV</strong> also remains available as a legacy technical/compatibility export.</p>
        </section>
        <section class="information-workflow" aria-labelledby="about-workflow">
            <h3 id="about-workflow">Typical workflow</h3>
            <ol>
                <li>Prepare and select a supported structured Power BI project. Analyse includes preparation guidance.</li>
                <li>Run the analysis.</li>
                <li>Start with the interactive HTML report.</li>
                <li>Export catalogue or usage metadata when useful.</li>
                <li>Review the evidence in context before making changes.</li>
                <li>Check generated files for sensitive metadata before sharing.</li>
            </ol>
        </section>
    </section>

    <section class="about-panel" role="tabpanel" tabindex="0" id="@PanelId(Trust)"
             aria-labelledby="@TabId(Trust)" hidden="@(active.Fragment != Trust.Fragment)">
        <h2>@Trust.Label</h2>
        <section class="information-panel" aria-labelledby="about-limitations">
            <h3 id="about-limitations">Important limitations</h3>
            <ul>
                <li><strong>Apparently unused does not mean safe to delete.</strong> PBI Assure sees the scanned project, not every external report or service dependency.</li>
                <li>Dynamic metadata and dependencies may limit certainty. Some Power BI constructs and formats have partial or version-specific coverage; review the evidence and coverage notes.</li>
                <li>Accessibility analysis supports manual review; it is not a WCAG compliance verdict. Theme Review is bounded and partial, not comprehensive compliance analysis.</li>
                <li>Metadata analysis does not validate runtime data correctness, refresh success or data quality.</li>
            </ul>
        </section>
        <section class="information-panel" aria-labelledby="about-privacy">
            <h3 id="about-privacy">Privacy and read-only analysis</h3>
            <p>Selected project metadata is processed in your browser. Normal project selection and scanning are read-only: PBI Assure does not modify the selected source project. The application code does not upload selected project content or generated results as part of scanning or export.</p>
            <p>Projects and results are held in application memory, not application-managed persistent browser storage. Leaving or reloading Analyse loses that working state; secure memory deletion is not guaranteed. Downloads may contain sensitive metadata, so review them before sharing.</p>
            <p>The only value PBI Assure stores in your browser is your Light, Dark or System appearance choice, so that the application and the reports it generates keep the appearance you picked. No project content or analysis result is stored.</p>
            <p>Loading the website requires normal site/runtime requests, and online HTML viewing can request a static same-origin viewer shell. Hosting infrastructure can receive ordinary request metadata. Offline scanning has been tested after the application has loaded; this is not a promise of zero network traffic or offline first-load availability.</p>
            <p><a href="https://github.com/whippet-dev/pbi-assure/blob/master/PRIVACY.md" target="_blank" rel="noopener noreferrer">Read the detailed privacy statement (opens in new tab)</a>.</p>
        </section>
    </section>
</article>

@code {
    private sealed record AboutTab(string Fragment, string Label);

    // The fragment is deliberately not the id of anything on the page. Opening /about#outputs must
    // select a tab, never make the browser scroll the heading out of view.
    private static readonly AboutTab Overview = new("overview", "Overview");
    private static readonly AboutTab Analysis = new("analysis", "Analysis");
    private static readonly AboutTab Outputs = new("outputs", "Outputs");
    private static readonly AboutTab Trust = new("trust", "Trust & limits");
    private static readonly AboutTab[] Tabs = [Overview, Analysis, Outputs, Trust];

    private readonly ElementReference[] tabButtons = new ElementReference[Tabs.Length];
    private AboutTab active = Overview;

    private static string TabId(AboutTab tab) => $"about-tab-{tab.Fragment}";

    private static string PanelId(AboutTab tab) => $"about-panel-{tab.Fragment}";

    protected override void OnInitialized()
    {
        active = TabFor(Navigation.Uri);
        Navigation.LocationChanged += OnLocationChanged;
    }

    public void Dispose() => Navigation.LocationChanged -= OnLocationChanged;

    /// <summary>Back and forward move between tabs rather than leaving the reader where they were.</summary>
    private void OnLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        var requested = TabFor(args.Location);
        if (requested.Fragment == active.Fragment)
        {
            return;
        }

        active = requested;
        StateHasChanged();
    }

    private static AboutTab TabFor(string uri)
    {
        var separator = uri.IndexOf('#', StringComparison.Ordinal);
        if (separator < 0)
        {
            return Overview;
        }

        var fragment = uri[(separator + 1)..];
        return Array.Find(Tabs, tab => string.Equals(tab.Fragment, fragment, StringComparison.OrdinalIgnoreCase))
            ?? Overview;
    }

    /// <summary>
    /// Selecting a tab is a same-document change: the fragment is updated so the view can be linked
    /// to and restored, but nothing navigates and nothing scrolls.
    ///
    /// A click earns a history entry. Arrow keys do not, because tabs activate as focus moves and a
    /// reader sweeping across the strip should not have to press Back four times to leave.
    /// </summary>
    private void Select(AboutTab tab, bool keepHistoryEntry)
    {
        active = tab;
        Navigation.NavigateTo($"about#{tab.Fragment}", forceLoad: false, replace: !keepHistoryEntry);
    }

    private async Task MoveAsync(KeyboardEventArgs args, int position)
    {
        // Left and right only. Home and End are optional in the tabs pattern and their default
        // action scrolls the document, which is the one thing this surface exists to avoid.
        var target = args.Key switch
        {
            "ArrowRight" => (position + 1) % Tabs.Length,
            "ArrowLeft" => (position - 1 + Tabs.Length) % Tabs.Length,
            _ => -1,
        };

        if (target < 0)
        {
            return;
        }

        Select(Tabs[target], keepHistoryEntry: false);
        // preventScroll: the whole point of this surface is that changing view never moves the page.
        await tabButtons[target].FocusAsync(preventScroll: true);
    }
}
