<header class="app-bar">
    <div class="app-bar-inner">
        <span class="brand">
            <img class="brand-mark" src="investigation/mark.svg" alt="" />PBI <strong>Project Lens</strong>
        </span>
        <nav class="app-navigation" aria-label="Application">
            <a href="" aria-current="@AriaCurrent(AppPage.Analyse)">Analyse</a>
            <a href="coverage" aria-current="@AriaCurrent(AppPage.Coverage)"
               target="@(LeavesWorkingState ? "_blank" : null)"
               rel="@(LeavesWorkingState ? "noopener noreferrer" : null)">
                Supported analysis
                @if (LeavesWorkingState)
                {
                    <span class="navigation-note" aria-label="opens in new tab">↗</span>
                }
            </a>
            <a href="about" aria-current="@AriaCurrent(AppPage.About)"
               target="@(LeavesWorkingState ? "_blank" : null)"
               rel="@(LeavesWorkingState ? "noopener noreferrer" : null)">
                About
                @if (LeavesWorkingState)
                {
                    <span class="navigation-note" aria-label="opens in new tab">↗</span>
                }
            </a>
        </nav>
        <AppearanceControl />
    </div>
</header>

@code {
    [Parameter] public AppPage Current { get; set; } = AppPage.Analyse;

    /// <summary>
    /// Analyse holds a selected project, a completed scan or a running scan in memory only. Leaving it
    /// would lose that state, so from there the information destinations open in a new tab instead.
    /// </summary>
    [Parameter] public bool HasActiveProject { get; set; }

    private bool LeavesWorkingState => HasActiveProject && Current == AppPage.Analyse;

    private string? AriaCurrent(AppPage page) => Current == page ? "page" : null;
}
