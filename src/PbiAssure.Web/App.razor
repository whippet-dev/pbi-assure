<ErrorBoundary>
    <ChildContent>
        <Router AppAssembly="typeof(App).Assembly">
            <Found Context="routeData">
                <RouteView RouteData="routeData" DefaultLayout="typeof(MainLayout)" />
                <FocusOnNavigate RouteData="routeData" Selector="h1" />
            </Found>
            <NotFound>
                <LayoutView Layout="typeof(MainLayout)">
                    <AppNavigation />
                    <div class="shell">
                        <p role="alert">That page was not found.</p>
                    </div>
                </LayoutView>
            </NotFound>
        </Router>
    </ChildContent>
    <ErrorContent>
        <LayoutView Layout="typeof(MainLayout)">
            <AppNavigation />
            <div class="shell">
                <section class="fatal-message" role="alert">
                    <h1>PBI Assure could not continue</h1>
                    <p>No project data was uploaded. Reload the page and choose the project again.</p>
                    <a class="button-link" href="">Reload PBI Assure</a>
                </section>
            </div>
        </LayoutView>
    </ErrorContent>
</ErrorBoundary>
