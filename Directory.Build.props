<Project>
  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <Product>PBI Project Lens</Product>
    <Description>A read-only investigation workspace for Power BI projects.</Description>
    <Authors>Whippet Dev</Authors>
    <Copyright>Copyright (c) 2026 Whippet Dev</Copyright>
    <RepositoryUrl>https://github.com/whippet-dev/pbi-assure</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>
</Project>
